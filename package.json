{
  "name": "uran",
  "version": "0.5.9",
  "description": "Decky companion plugin for ASSella: search games, inject SLSsteam config, and manage Hubcap manifests and depot keys",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "package": "shx rm -rf dist && rollup -c && python3 build_zip.py",
    "watch": "rollup -c -w",
    "test": "python3 tests/run_all.py"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "plugin",
    "assella",
    "slssteam"
  ],
  "author": "niwia",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0",
    "qrcode": "^1.5.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "ws": "^8.22.0"
  }
}
